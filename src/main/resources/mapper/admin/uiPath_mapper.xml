<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kd.insuranceweb.admin.mapper.UiPathMapper">
  <select id="SelectOne" resultType="com.kd.insuranceweb.admin.dto.UiPathNoticeDto">
	SELECT *
	FROM (
	    SELECT id, content, created
	    FROM uipath_notice
	    ORDER BY created DESC
	)
	WHERE ROWNUM = 1
  </select>
 
</mapper>